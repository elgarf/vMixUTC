  <PropertyGroup>
    <!--
      Post-build:
      1. Move os binários nativos do VLC (libvlc.dll, libvlccore.dll, plugins\) para a
         subpasta vlc\ — assim eles NÃO são apagados pela limpeza abaixo.
      2. Apaga outros DLLs que não terminam em "DataProvider.dll" (padrão do projeto).
         A subpasta vlc\ não é afetada pois "dir /b /a-d" lista apenas arquivos.
    -->
    <PostBuildEvent>
cd $(OutDir)
if not exist vlc mkdir vlc
if exist libvlc.dll move /y libvlc.dll vlc\libvlc.dll
if exist libvlccore.dll move /y libvlccore.dll vlc\libvlccore.dll
if exist plugins xcopy /e /q /y plugins\ vlc\plugins\
if exist plugins rmdir /s /q plugins
del vMixControllerDataProvider.dll /q 2&gt;nul
for /f %%F in ('dir /b /a-d ^| findstr /vile "DataProvider.dll"') do del "%%F" /Q /S
    </PostBuildEvent>
  </PropertyGroup>
