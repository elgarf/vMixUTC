<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ctrl="clr-namespace:vMixController.Controls"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:mdl="clr-namespace:vMixController.Widgets"
        xmlns:views="clr-namespace:vMixController.ViewModel"
        xmlns:input="clr-namespace:System.Windows.Input;assembly=WindowsBase"
        xmlns:Converters="clr-namespace:vMixController.Converters" x:Class="vMixController.vMixWidgetSettingsView"
        xmlns:e="clr-namespace:vMixController.Extensions"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        
        xmlns:this="clr-namespace:vMixController"
        xmlns:pctrl="clr-namespace:vMixController.PropertiesControls"
        xmlns:wpfc="clr-namespace:NKristek.Wpf.Converters;assembly=NKristek.Wpf.Converters"
        xmlns:skin="clr-namespace:vMixControllerSkin;assembly=vMixControllerSkin"
        xmlns:loc="clr-namespace:vMixControllerSkin.Localization;assembly=vMixControllerSkin"
        mc:Ignorable="d"
        Title="{loc:Loc Key=WidgetSettings.Window.Title}"
        Closing="Window_Closing" d:DesignWidth="382.485" d:DesignHeight="364.71"
        Width="{Binding WindowProperties.A, Mode=TwoWay, FallbackValue=382}"
        Height="{Binding WindowProperties.B, Mode=TwoWay, FallbackValue=364}"
        Top="{Binding WindowProperties.C, Mode=TwoWay, FallbackValue=256}"
        Left="{Binding WindowProperties.D, Mode=TwoWay, FallbackValue=256}"
        WindowStartupLocation="CenterScreen" Background="Black" ResizeMode="CanResize"
        e:ControlBox.HasMaximizeButton="False" Loaded="Window_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vMixControllerSkin;component/MainSkin.xaml" />
                <ResourceDictionary Source="/Skins/PropertyEditorTemplates.xaml" />
                <!--<x:Static Member="skin:ExportResourceDictionary.Instance"/>-->

            </ResourceDictionary.MergedDictionaries>
            <ObjectDataProvider x:Key="KeyValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Key"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
            <!--<this:Help x:Key="Help"/>-->
            <Style TargetType="{x:Type ListView}">
                <Setter Property="Background" Value="Black"/>
            </Style>
            <Style TargetType="{x:Type ListViewItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListViewItem}">
                            <Border Background="#1E2328" BorderBrush="#18488C" x:Name="Border" Margin="0,0,0,4" Padding="1" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DrawingBrush x:Key="BYTile" TileMode="Tile" 
                          Viewport="0,0,64,64" ViewportUnits="Absolute">
                <DrawingBrush.Drawing>

                    <GeometryDrawing>

                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,64,64" />
                        </GeometryDrawing.Geometry>

                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="Gray" Offset="0.0" />
                                <GradientStop Color="Gray" Offset="0.25" />
                                <GradientStop Color="Black"  Offset="0.25" />
                                <GradientStop Color="Black"  Offset="0.5" />
                                <GradientStop Color="Gray" Offset="0.5" />
                                <GradientStop Color="Gray" Offset="0.75" />
                                <GradientStop Color="Black"  Offset="0.75" />
                                <GradientStop Color="Black"  Offset="1.0" />
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                </DrawingBrush.Drawing>
            </DrawingBrush>
        </ResourceDictionary>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction PassEventArgsToCommand="True" Command="{Binding ClosingCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid Background="Black">

        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <VirtualizingStackPanel Margin="8">
                <Grid Margin="{StaticResource TopBottomStdMargin}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
					<TextBlock Style="{StaticResource PropertyName}" Margin="{StaticResource RightStdMargin}" FontSize="16"><InlineUIContainer>
							<TextBlock Text="{Binding Widget.Type, Mode=OneWay}"/>
						</InlineUIContainer><Run Text=" " /><Run Text="{loc:Loc Key=WidgetSettings.WidgetSuffix}"/></TextBlock>
                    <Border VerticalAlignment="Center" Grid.Column="1" BorderThickness="0,2,0,0" BorderBrush="White"/>
                </Grid>
                <pctrl:LabelControl Foreground="Green" Title="{loc:Loc Key=WidgetSettings.CommonProperties}"/>
                <StackPanel x:Name="CommonProperties">
                    <Grid Margin="{StaticResource TopBottomStdMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="{StaticResource Main.Gradient}">
                            <TextBlock Padding="{StaticResource StdMargin}" Style="{StaticResource PropertyName}"><Run FontWeight="Normal" FontFamily="{StaticResource FontAwesome}">&#xf031;</Run><Run Text=" "></Run><Run Text="{loc:Loc Key=WidgetSettings.Field.Name}"/></TextBlock>
                        </Grid>
                        <TextBox Style="{StaticResource WidgetTextBox}" Grid.Column="1" Text="{Binding Widget.Name, UpdateSourceTrigger=Explicit, Mode=TwoWay}" AcceptsReturn="True" Height="Auto"/>
                    </Grid>
                    <Grid Margin="{StaticResource TopBottomStdMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="{StaticResource Main.Gradient}">
                            <TextBlock Padding="{StaticResource StdMargin}" Style="{StaticResource PropertyName}"><Run FontWeight="Normal" FontFamily="{StaticResource FontAwesome}">&#xf1fc;</Run><Run Text=" "></Run><Run Text="{loc:Loc Key=WidgetSettings.Field.Color}"/></TextBlock>
                        </Grid>
                        <ComboBox Grid.Column="1" ItemsSource="{x:Static views:vMixWidgetSettingsViewModel.Colors}" SelectedValue="{Binding Widget.Color, UpdateSourceTrigger=Explicit, Mode=TwoWay, Converter={Converters:ColorToColorFromListConverter}}" SelectedValuePath="A">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Rectangle Height="16" Width="16" Margin="{StaticResource RightStdMargin}" StrokeThickness="2" Stroke="{Binding B, Converter={Converters:ColorToSolidBrushConverter}}" Fill="{Binding A, Converter={Converters:ColorToSolidBrushConverter}}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding C}"/>
                                    </Grid>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Grid Margin="{StaticResource TopBottomStdMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Background="{StaticResource Main.Gradient}">
                            <TextBlock Padding="{StaticResource StdMargin}" Style="{StaticResource PropertyName}"><Run FontWeight="Normal" FontFamily="{StaticResource FontAwesome}">&#xf160;</Run><Run Text=" "></Run><Run Text="{loc:Loc Key=WidgetSettings.Field.ZIndex}"/></TextBlock>
                        </Grid>
                        <TextBox Style="{StaticResource WidgetTextBox}" Grid.Column="1" Text="{Binding Widget.ZIndex, UpdateSourceTrigger=Explicit, Mode=TwoWay}" AcceptsReturn="False" Height="Auto"/>
                    </Grid>
                    <StackPanel Visibility="{Binding Widget.Hotkey.Length, Converter={wpfc:ObjectToStringEqualsParameterToInverseVisibilityConverter}, ConverterParameter=0, Mode=OneWay}" Margin="{StaticResource TopBottomStdMargin}">
                        <Grid Margin="{StaticResource StdMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Margin="0,0,8,0" VerticalAlignment="Center" IsChecked="{Binding IsHotkeysVisible}" Foreground="LightGray" Background="Transparent">
                                <CheckBox.Template>
                                    <ControlTemplate TargetType="CheckBox">
                                        <Border Width="16" Height="16" Background="{TemplateBinding Background}">
                                            <TextBlock x:Name="Text" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="{StaticResource FontAwesome}" Foreground="{TemplateBinding Foreground}" Text="&#xf146;"></TextBlock>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="Black"/>
                                                <Setter Property="Background" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Text" Property="Text" Value="&#xf0fe;"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </CheckBox.Template>
                            </CheckBox>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="14" Style="{StaticResource PropertyName}" Margin="-4,0,0,0"><Run Text="{loc:Loc Key=WidgetSettings.Hotkeys}"/></TextBlock>
                            <Control Grid.Column="2" Style="{StaticResource HelpBorder}" ToolTip="{loc:Loc Key=Help.Hotkeys.Default}" Margin="{StaticResource LeftRightStdMargin}"/>
                            <Border VerticalAlignment="Center"  Grid.Column="3" BorderThickness="0,2,0,0" BorderBrush="White"/>
                        </Grid>
                        <Grid Background="{StaticResource BYTile}">
                            <Border x:Name="HotkeysPlaceholder">
                                <ListView VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" ItemsSource="{Binding Widget.Hotkey, Converter={Converters:ObservableCollectionCopyConverter}, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Visibility="{Binding IsHotkeysVisible, Converter={wpfc:BoolToVisibilityConverter}}">
                                    <ListView.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard Storyboard.TargetName="HotkeysPlaceholder" Storyboard.TargetProperty="Visibility">
                                                    <ObjectAnimationUsingKeyFrames>
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                <Visibility>Hidden</Visibility>
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.01">
                                                            <DiscreteObjectKeyFrame.Value>
                                                                <Visibility>Visible</Visibility>
                                                            </DiscreteObjectKeyFrame.Value>
                                                        </DiscreteObjectKeyFrame>
                                                    </ObjectAnimationUsingKeyFrames>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </ListView.Triggers>
                                    <i:Interaction.Behaviors>
                                        <e:IgnoreMouseWheelBehavior/>
                                    </i:Interaction.Behaviors>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListViewItem}">
                                                        <Border Background="{TemplateBinding Background}" >
                                                            <Border BorderThickness="4,0,0,0" BorderBrush="{TemplateBinding BorderBrush}">
                                                                <GridViewRowPresenter Margin="-4,0,0,0"/>
                                                            </Border>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Active}" Value="True">
                                                    <Setter Property="BorderBrush" Value="#FF90ee90"/>
                                                    <Setter Property="Background" Value="{StaticResource Main.Gradient}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.View>
                                        <GridView>
                                            <GridView.ColumnHeaderContainerStyle>
                                                <Style TargetType="GridViewColumnHeader">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                                                                <Border ToolTip="{TemplateBinding ToolTip}">
                                                                    <TextBlock VerticalAlignment="Center" Foreground="White" x:Name="ContentHeader" Text="{TemplateBinding Content}" Padding="5,5,5,0" Width="{TemplateBinding Width}" />
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </GridView.ColumnHeaderContainerStyle>

											<GridViewColumn Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Active}" ToolTipService.ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.Active}" Width="Auto">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Active, Mode=TwoWay}" Margin="0,0,-6,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Name}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Label Content="{Binding Name, Converter={Converters:StringToLocalizedStringConverter}, ConverterParameter=WidgetSettings.Hotkeys.Hotkey}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="20" Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Alt}" ToolTipService.ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.Alt}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" IsEnabled="{Binding Active}" IsChecked="{Binding Alt, Mode=TwoWay}" Margin="-5,0" ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.Alt}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="24" Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Ctrl}" ToolTipService.ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.Ctrl}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" IsEnabled="{Binding Active}" IsChecked="{Binding Ctrl, Mode=TwoWay}" Margin="-5,0" ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Ctrl}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="32" Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Shift}" ToolTipService.ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.Shift}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" IsEnabled="{Binding Active}" IsChecked="{Binding Shift, Mode=TwoWay}" Margin="-5,0" ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.Shift}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.OnPress}" ToolTipService.ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.OnPress}">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <CheckBox HorizontalAlignment="Center" IsEnabled="{Binding Active}" IsChecked="{Binding OnPress, Mode=TwoWay}" Margin="-5,0" ToolTip="{loc:Loc Key=WidgetSettings.Hotkeys.ToolTip.OnPress}"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Key}" Width="80">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox IsEnabled="{Binding Active}" SelectedItem="{Binding Key, Mode=TwoWay}" ItemsSource="{Binding Source={StaticResource KeyValues}}" Margin="-5,0">
                                                            <ComboBox.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <VirtualizingStackPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ComboBox.ItemsPanel>
                                                        </ComboBox>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Header="{loc:Loc Key=WidgetSettings.Hotkeys.Column.Link}" Width="100">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBox Style="{StaticResource WidgetTextBox}" IsEnabled="{Binding Active}" Text="{Binding Link}" Margin="-5,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                            <GridViewColumn Width="50">
                                                <GridViewColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button IsEnabled="{Binding Active}" Content="{loc:Loc Key=WidgetSettings.Hotkeys.Button.Learn}" Command="{Binding DataContext.LearnKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="-5,0,-6,0"/>
                                                    </DataTemplate>
                                                </GridViewColumn.CellTemplate>
                                            </GridViewColumn>
                                        </GridView>
                                    </ListView.View>
                                    <ListView.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel/>
                                        </ItemsPanelTemplate>
                                    </ListView.ItemsPanel>
                                </ListView>
                            </Border>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <pctrl:LabelControl Foreground="Orange" Title="{loc:Loc Key=WidgetSettings.IndividualProperties}" Visibility="{Binding Content, ElementName=WidgetProperties, Converter={Converters:ContentToVisibilityConverter}, Mode=OneWay}"/>
                <Border x:Name="IndividualPropertiesLoader" Background="{StaticResource BYTile}" Margin="-2" Padding="2">
                    <ContentPresenter x:Name="WidgetProperties" Content="{Binding Widget, UpdateSourceTrigger=PropertyChanged}">
                        <ContentPresenter.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard Storyboard.TargetProperty="Visibility">
                                        <ObjectAnimationUsingKeyFrames>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Hidden</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="IndividualPropertiesLoader">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{StaticResource BYTile}"/>
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.01">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <SolidColorBrush>Transparent</SolidColorBrush>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentPresenter.Triggers>
                        <ContentPresenter.ContentTemplateSelector>
                            <ctrl:TypeTemplateSelector Suffix="PropEditor"/>
                        </ContentPresenter.ContentTemplateSelector>
                    </ContentPresenter>
                </Border>
                <!--<ItemsControl VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VerticalContentAlignment="Stretch" ItemsSource="{Binding WidgetPropertiesControls}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>-->
            </VirtualizingStackPanel>
        </ScrollViewer>
        <StackPanel Margin="2" HorizontalAlignment="Right" Orientation="Horizontal" Grid.Row="1">
            <Button Margin="0,0,4,0" Command="{Binding SaveTemplateCommand}" Content="{loc:Loc Key=WidgetSettings.Button.SaveTemplate}" IsEnabled="{Binding Widget.IsTemplate, Converter={wpfc:BoolToInverseBoolConverter}}" ToolTip="{loc:Loc Key=Help.SaveTemplate.Default}" Click="SaveTemplateClick"/>
            <Button Margin="0,0,4,0" Command="{Binding CancelCommand}" IsCancel="True" Content="{loc:Loc Key=WidgetSettings.Button.Cancel}" Click="CancelClick"/>
            <Button Command="{Binding OkCommand}" Content="{loc:Loc Key=WidgetSettings.Button.Ok}" IsDefault="True" Click="OkClick"/>
        </StackPanel>
    </Grid>
</Window>

