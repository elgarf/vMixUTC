<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>vMixController</RootNamespace>
    <AssemblyName>vMixController</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <ApplicationIcon>settings-gears (1).ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Deterministic>false</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <DefineConstants>CODE_ANALYSIS;DEBUG;TRACE</DefineConstants>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>false</Optimize>
    <OutputPath>bin\\Debug\\$(TargetFramework)\\</OutputPath>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DefineConstants>TRACE</DefineConstants>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\\Release\\$(TargetFramework)\\</OutputPath>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\ncalc\Evaluant.Calculator\NCalc.csproj" />
    <ProjectReference Include="..\HighPrecisionTimer\HighPrecisionTimer.csproj" />
    <ProjectReference Include="..\Popcron.Sheets\Popcron.Sheets.csproj" />
    <ProjectReference Include="..\vMixAPI\vMixAPI.csproj" />
    <ProjectReference Include="..\vMixControllerDataProvider\vMixControllerDataProvider.csproj" />
    <ProjectReference Include="..\vMixControllerSkin\vMixControllerSkin.csproj" />
    <ProjectReference Include="..\vMixStreamDeckLibrary\vMixStreamDeckLibrary.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AvalonEdit" />
    <PackageReference Include="Common.Logging" />
    <PackageReference Include="Common.Logging.Core" />
    <PackageReference Include="CommonServiceLocator" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Costura.Fody">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Extended.Wpf.Toolkit" />
    <PackageReference Include="ExtendedNumerics.BigDecimal" />
    <PackageReference Include="Fody">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="Melanchall.DryWetMidi" />
    <PackageReference Include="MemoryMessagePipe" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Logging.TraceSource" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Primitives" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" />
    <PackageReference Include="MouseKeyHook" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="NAudio.Wasapi" />
    <PackageReference Include="NKristek.Wpf.Converters" />
    <PackageReference Include="NLog" />
    <PackageReference Include="NLog.Schema" />
    <PackageReference Include="Octokit" />
    <PackageReference Include="Ookii.Dialogs.Wpf" />
    <PackageReference Include="Parlot" />
    <PackageReference Include="Sanford.Multimedia.Midi" />
    <PackageReference Include="SplashScreenGdip" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="VirtualizingWrapPanel" />
    <PackageReference Include="WatsonWebsocket" />
    <PackageReference Include="WpfScreenHelper" />
    <PackageReference Include="WriteableBitmapEx" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="costura-mac-x64\Melanchall_DryWetMidi_Native64.dylib" />
    <EmbeddedResource Include="costura-win-x86\Melanchall_DryWetMidi_Native32.dll" />
    <EmbeddedResource Include="costura-win-x64\Melanchall_DryWetMidi_Native64.dll" />
    <EmbeddedResource Include="costura-win-x64\libomt.dll" />
    <EmbeddedResource Include="costura-win-x64\libomtnet.dll" />
    <EmbeddedResource Include="costura-win-x64\libvmx.dll" />
    <EmbeddedResource Include="costura-win-x64\Processing.NDI.Lib.x64.dll" />
    <EmbeddedResource Include="costura-win-x86\Processing.NDI.Lib.x86.dll" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Images\Function.png" />
    <Resource Include="Images\Input.png" />
    <Resource Include="settings-gears (1).ico" />
    <Resource Include="settings-gears.ico" />
    <Resource Include="Grid.png" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Colours.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="ControllerHighlight.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Functions.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NewFunctions.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="vmixUTC.streamDeckPlugin">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Update="Examples\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <Resource Include="FodyWeavers.xml" />
  </ItemGroup>
  <Target Name="CleanupDataProvidersFolder" AfterTargets="Build" Condition="Exists('$(TargetDir)DataProviders')">
    <ItemGroup>
      <_DeleteProviderFiles Include="$(TargetDir)DataProviders\vMixControllerDataProvider.dll" />
      <_DeleteProviderFiles Include="$(TargetDir)DataProviders\WeatherExternalDataProvider.dll;$(TargetDir)DataProviders\WeatherExternalDataProvider.pdb;$(TargetDir)DataProviders\WeatherExternalDataProvider.deps.json;$(TargetDir)DataProviders\WeatherExternalDataProvider.dll.config" />
    </ItemGroup>
    <Delete Files="@(_DeleteProviderFiles)" TreatErrorsAsWarnings="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -LiteralPath '$(TargetDir)DataProviders' -Directory -Recurse -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | ForEach-Object { if (-not (Get-ChildItem -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue)) { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue } }&quot;" />
  </Target>
  <Target Name="DedupeDataProvidersAgainstRoot" AfterTargets="CleanupDataProvidersFolder" Condition="Exists('$(TargetDir)DataProviders')">
    <ItemGroup>
      <_ProviderMainDlls Include="$(TargetDir)DataProviders\*DataProvider.dll" />
      <_ProviderDependencyDlls Include="$(TargetDir)DataProviders\*.dll" Exclude="@(_ProviderMainDlls)" />
      <_ProviderDuplicateDlls Include="@(_ProviderDependencyDlls)" Condition="Exists('$(TargetDir)%(Filename)%(Extension)')" />
    </ItemGroup>
    <Delete Files="@(_ProviderDuplicateDlls)" TreatErrorsAsWarnings="true" />
  </Target>
  <Target Name="CleanupProviderArtifactsFromRoot" AfterTargets="Build">
    <ItemGroup>
      <_ProviderRootArtifacts Include="$(TargetDir)*DataProvider.dll;$(TargetDir)*DataProvider.pdb;$(TargetDir)*DataProvider.deps.json;$(TargetDir)*DataProvider.dll.config" />
      <_ProviderRootArtifacts Include="$(TargetDir)vMixControllerDataProvider.dll;$(TargetDir)vMixControllerDataProvider.pdb" />
    </ItemGroup>
    <Delete Files="@(_ProviderRootArtifacts)" TreatErrorsAsWarnings="true" />
  </Target>
  <Target Name="CleanupLegacyMelanchallFiles" AfterTargets="Build;CopyFilesToOutputDirectory">
    <Delete Files="$(TargetDir)Melanchall*.dll;$(TargetDir)Melanchall*.dylib;$(TargetDir)Melanchall_DryWetMidi_Native32.dll;$(TargetDir)Melanchall_DryWetMidi_Native64.dll;$(TargetDir)Melanchall_DryWetMidi_Native64.dylib" TreatErrorsAsWarnings="true" />
    <RemoveDir Directories="$(TargetDir)net472" Condition="Exists('$(TargetDir)net472')" />
  </Target>
  <Target Name="CleanupPluginDependenciesFromRoot" AfterTargets="Build">
    <Delete Files="$(TargetDir)Json.More.dll;$(TargetDir)JsonPath.Net.dll;$(TargetDir)ExcelDataReader.dll" TreatErrorsAsWarnings="true" />
  </Target>
  <Target Name="CleanupEmbeddedProjectReferencesFromRoot" AfterTargets="Build">
    <ItemGroup>
      <_EmbeddedProjectArtifacts Include="$(TargetDir)HighPrecisionTimer.dll;$(TargetDir)HighPrecisionTimer.pdb" />
      <_EmbeddedProjectArtifacts Include="$(TargetDir)NCalc.dll;$(TargetDir)NCalc.pdb" />
      <_EmbeddedProjectArtifacts Include="$(TargetDir)Popcron.Sheets.dll;$(TargetDir)Popcron.Sheets.pdb" />
      <_EmbeddedProjectArtifacts Include="$(TargetDir)vMixAPI.dll;$(TargetDir)vMixAPI.pdb;$(TargetDir)vMixAPI.dll.config" />
      <_EmbeddedProjectArtifacts Include="$(TargetDir)vMixControllerDataProvider.dll;$(TargetDir)vMixControllerDataProvider.pdb" />
      <_EmbeddedProjectArtifacts Include="$(TargetDir)vMixControllerSkin.dll;$(TargetDir)vMixControllerSkin.pdb;$(TargetDir)vMixControllerSkin.dll.config" />
      <_EmbeddedProjectArtifacts Include="$(TargetDir)vMixStreamDeckLibrary.dll;$(TargetDir)vMixStreamDeckLibrary.pdb" />
    </ItemGroup>
    <Delete Files="@(_EmbeddedProjectArtifacts)" TreatErrorsAsWarnings="true" />
  </Target>
  <Target Name="CleanupOutputClutter" AfterTargets="Build">
    <Delete Files="$(TargetDir)fatal.log" TreatErrorsAsWarnings="true" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;if (Test-Path -LiteralPath '$(TargetDir)logs') { Get-ChildItem -LiteralPath '$(TargetDir)logs' -Force -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; if (-not (Get-ChildItem -LiteralPath '$(TargetDir)logs' -Force -ErrorAction SilentlyContinue)) { Remove-Item -LiteralPath '$(TargetDir)logs' -Force -ErrorAction SilentlyContinue } }&quot;" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Get-ChildItem -LiteralPath '$(TargetDir)' -Directory -Recurse -ErrorAction SilentlyContinue | Sort-Object FullName -Descending | ForEach-Object { if (-not (Get-ChildItem -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue)) { Remove-Item -LiteralPath $_.FullName -Force -ErrorAction SilentlyContinue } }&quot;" />
  </Target>
  <Target Name="CopySkinSatelliteResourcesToHost" AfterTargets="Build">
    <ItemGroup>
      <_SkinSatelliteResources Include="$(MSBuildThisFileDirectory)..\vMixControllerSkin\bin\$(Configuration)\$(TargetFramework)\**\vMixControllerSkin.resources.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SkinSatelliteResources)"
          DestinationFiles="@(_SkinSatelliteResources->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_SkinSatelliteResources)' != ''" />
    <Delete Files="$(TargetDir)vMixControllerSkin.resources.dll" TreatErrorsAsWarnings="true" />
  </Target>
</Project>
