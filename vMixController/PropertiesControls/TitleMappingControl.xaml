<UserControl x:Class="vMixController.PropertiesControls.TitleMappingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:vMixController.PropertiesControls"
             xmlns:e="clr-namespace:vMixController.Extensions"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:wpfc="clr-namespace:NKristek.Wpf.Converters;assembly=NKristek.Wpf.Converters"
             xmlns:loc="clr-namespace:vMixControllerSkin.Localization;assembly=vMixControllerSkin"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="Me">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vMixControllerSkin;component/MainSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Behaviors>
        <e:IgnoreMouseWheelBehavior/>
    </i:Interaction.Behaviors>
    <Border BorderBrush="#1A3CB1" BorderThickness="1" Background="#18488C" Margin="{StaticResource TopBottomStdMargin}">
        <StackPanel Margin="{StaticResource StdMargin}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PropertyName}" Margin="{StaticResource RightStdMargin}" VerticalAlignment="Center"><Run FontWeight="Normal" FontFamily="{StaticResource FontAwesome}">&#xf039;</Run><Run Text=" "/><Run Text="{loc:Loc Key=TitleMapping.Title}"/></TextBlock>
                <Button ToolTip="{loc:Loc Key=TitleMapping.ToolTip.Add}" Style="{StaticResource TitleButton}" Command="{Binding AddPathCommand, ElementName=Me}" Content="&#x2b;"/>
                <Control Style="{StaticResource HelpBorder}">
                    <Control.ToolTip>
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=TitleMapping.Help.Line1}"/>
                            <TextBlock Text="{loc:Loc Key=TitleMapping.Help.Line2}"/>
                        </StackPanel>
                    </Control.ToolTip>
                </Control>
                <!--<CheckBox Visibility="Hidden" Style="{StaticResource CheckBox}" IsChecked="{Binding IsGUIDTargeted, ElementName=Me}" VerticalAlignment="Center">Map To GUID</CheckBox>-->
            </StackPanel>
            <ListView Background="Transparent" BorderThickness="0" ItemsSource="{Binding Titles, ElementName=Me}" HorizontalContentAlignment="Stretch" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Grid.Column="1" Margin="2,0,0,0" HorizontalAlignment="Right">
                                <Button Style="{StaticResource TitleButton}" HorizontalAlignment="Left" Command="{Binding RemovePathCommand, ElementName=Me}" CommandParameter="{Binding}" Content="&#xF2ED;"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="InputSelector"
                                          Grid.Column="0"
                                          ItemTemplate="{StaticResource InputSelectorTemplate}"
                                          SelectedValuePath="Key"
                                          SelectedValue="{Binding A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding AvailableInputs, ElementName=Me}"/>
                                <ComboBox Grid.Column="2"
                                          IsEnabled="{Binding SelectedItem, ElementName=InputSelector, Converter={wpfc:ValueNullToInverseBoolConverter}}"
                                          ItemsSource="{Binding SelectedItem.Elements, ElementName=InputSelector}"
                                          SelectedValuePath="Name"
                                          SelectedValue="{Binding B, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>[<Run Text="{Binding Type, Mode=OneWay}"/>] <Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border Margin="2" HorizontalAlignment="Stretch">
                                        <ContentPresenter/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
            <Button Width="Auto" Style="{StaticResource TitleButton}" FontFamily="{StaticResource SegoeUI}" Command="{Binding AddPathCommand, ElementName=Me}" Content="{loc:Loc Key=TitleMapping.Button.Append}"/>
        </StackPanel>
    </Border>
</UserControl>

