<UserControl x:Class="vMixController.PropertiesControls.ScriptControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:this="clr-namespace:vMixController"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:vMixController.PropertiesControls"
             xmlns:ctrls="clr-namespace:vMixController.Controls"
             xmlns:e="clr-namespace:vMixController.Extensions"
             xmlns:conv="clr-namespace:vMixController.Converters"
             xmlns:cls="clr-namespace:vMixController.Classes"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:c="clr-namespace:System;assembly=mscorlib"
             xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:w="clr-namespace:vMixController.Widgets"
             xmlns:wpfc="clr-namespace:NKristek.Wpf.Converters;assembly=NKristek.Wpf.Converters" xmlns:sys="http://schemas.microsoft.com/netfx/2009/xaml/presentation" xmlns:vmixapi="clr-namespace:vMixAPI;assembly=vMixAPI"
             xmlns:loc="clr-namespace:vMixControllerSkin.Localization;assembly=vMixControllerSkin"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="Me">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vMixControllerSkin;component/MainSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Storyboard x:Key="Blink">
                <ColorAnimation Storyboard.TargetProperty="BorderBrush.Color" To="Lime" Duration="00:00:00.5" AutoReverse="True" RepeatBehavior="2x"/>
            </Storyboard>
        </ResourceDictionary>
    </UserControl.Resources>
    <i:Interaction.Behaviors>
        <e:IgnoreMouseWheelBehavior/>
        <e:DeepCopyCancelBehavior TargetCollection="{Binding Commands, ElementName=Me}" IsCancelled="{Binding IsCancelled, ElementName=Me}"></e:DeepCopyCancelBehavior>
    </i:Interaction.Behaviors>
    <StackPanel>
        <Border BorderBrush="#D01818" Background="#8B0000" BorderThickness="1" Margin="{StaticResource TopBottomStdMargin}">
            <StackPanel Margin="{StaticResource StdMargin}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource PropertyName}" Margin="{StaticResource RightStdMargin}" VerticalAlignment="Center"><Run FontWeight="Normal" FontFamily="{StaticResource FontAwesome}">&#xf233;</Run><Run Text=" "/><Run Text="{loc:Loc Key=ScriptEditor.Title}"/></TextBlock>
                    <Button ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.AddCommand}" Style="{StaticResource TitleButton}" Command="{Binding AddCommandCommand, ElementName=Me}" Content="&#x2b;"/>
                    <Button ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.ClearScript}" Style="{StaticResource TitleButton}" Command="{Binding ClearScriptCommand, ElementName=Me}" Content="&#xF51A;"/>
                    <Border BorderThickness="1,0,0,0" Margin="1" BorderBrush="White"/>
                    <Button ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.ExportScript}" Style="{StaticResource TitleButton}" Command="{Binding ExportScriptCommand, ElementName=Me}" Content="&#xF574;"/>
                    <Button ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.ImportScript}" Style="{StaticResource TitleButton}" Command="{Binding ImportScriptCommand, ElementName=Me}" Content="&#xF56d;"/>
                    <Control Style="{StaticResource HelpBorder}" ToolTip="{loc:Loc Key=Help.Script.Default}"/>
                </StackPanel>

                <TabControl SelectionChanged="TabControl_SelectionChanged" BorderBrush="#D01818" Background="#8B0000">
                    <TabItem Style="{StaticResource TabItemStyle}" Header="{loc:Loc Key=ScriptEditor.Tab.Constructor}">
                        <StackPanel>
                            <ListView VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" x:Name="script" AlternationCount="{Binding Commands.Count, ElementName=Me}" ItemsSource="{Binding Commands, ElementName=Me}" SelectedIndex="0" HorizontalContentAlignment="Stretch">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,-4" Padding="0,0,0,4" x:Name="Border" BorderBrush="Gray" BorderThickness="4,0,0,0">
                                            <Grid DataContext="{Binding}" x:Name="Element" Background="{StaticResource Main.Gradient}">
                                                <Grid.Resources>
                                                    <DataTemplate x:Key="CollapsedViewTemplate">
                                                        <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis">
                                    <Run Background="White" FontWeight="Bold" Text="{Binding Action.Function, FallbackValue=None}" Foreground="{Binding Action.Color, Converter={conv:ColorToSolidBrushConverter}}">
                                    </Run>
                                    (&lt;<Run FontWeight="Regular" Foreground="Red" Text="{Binding InputKey}"/>&gt;, <Run Foreground="Lime" FontWeight="Regular" Text="{Binding Parameter}"/>, "<Run FontWeight="Regular" Foreground="CornflowerBlue" Text="{Binding AdditionalParameters, Converter={conv:ParametersToStringConverter}}"/><Run Foreground="CornflowerBlue" FontWeight="Regular" Text="{Binding StringParameter}"/>")

                                                        </TextBlock>

                                                    </DataTemplate>
                                                    <DataTemplate x:Key="ExpandedViewTemplate">
                                                        <Grid e:AutoGridRowBehavior.IsEnabled="True" e:AutoGridRowBehavior.ItemMargin="0,4,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition/>
                                                                <ColumnDefinition Width="2*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Label Content="{loc:Loc Key=ScriptEditor.Field.Command}"/>
                                                            <ComboBox x:Name="Func" Grid.Row="1" IsEditable="True" SelectedItem="{Binding Action, Mode=TwoWay}" DisplayMemberPath="Function" ItemsSource="{Binding DataContext.Functions, RelativeSource={RelativeSource AncestorType=Window}}" PreviewKeyDown="Func_PreviewKeyDown">
                                                                <ComboBox.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <VirtualizingStackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ComboBox.ItemsPanel>
                                                                <ComboBox.ItemContainerStyle>
                                                                    <Style TargetType="ComboBoxItem">
                                                                        <Style.Setters>
                                                                            <Setter Property="Foreground" Value="{Binding Color, Converter={conv:ColorToSolidBrushConverter}}"/>
                                                                            <Setter Property="ContentTemplateSelector" Value="{x:Null}"/>
                                                                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                                                                        </Style.Setters>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding ="{Binding IsGroup}" Value="True">
                                                                                <Setter Property="ComboBoxItem.Focusable" Value="False"/>
                                                                                <Setter Property="ComboBoxItem.IsEnabled" Value="False"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding IsGroup}" Value="False">
                                                                                <Setter Property="Margin" Value="8,0,0,0"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </ComboBox.ItemContainerStyle>
                                                            </ComboBox>
                                                            <Label x:Name="InLabel" Content="{Binding SelectedValue.InputDescription, ElementName=Func, FallbackValue=N/A}"/>
                                                            <ComboBox x:Name="In" IsEnabled="{Binding SelectedValue.HasInputProperty, ElementName=Func, FallbackValue=False}"  ItemTemplate="{StaticResource InputSelectorTemplate}" SelectedValuePath="Key" SelectedValue="{Binding InputKey, Mode=TwoWay}" ItemsSource="{Binding AvailableInputs, ElementName=Me}"/>
                                                            <Label x:Name="IntValuesLabel" Content="{Binding SelectedValue.IntDescription, ElementName=Func, FallbackValue=N/A}"/>
                                                            <Grid x:Name="IntValuesGrid" IsEnabled="{Binding SelectedValue.HasIntProperty, ElementName=Func, FallbackValue=False}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Height="Auto" Margin="0,3,0,2" TextWrapping="Wrap" Style="{StaticResource WidgetTextBox}" Visibility="{Binding SelectedValue.IntValues, ElementName=Func, Converter={wpfc:ValueNullToVisibilityConverter}}" Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <Button Visibility="{Binding SelectedValue.IntValues, ElementName=Func, Converter={wpfc:ValueNullToVisibilityConverter}}" IsEnabled="{Binding SelectedValue.HasInputProperty, ElementName=Func, FallbackValue=False}" Grid.Column="1" Height="Auto" Tag="{Binding DataContext, ElementName=Element}" Style="{StaticResource TitleButton}" DataContext="{Binding SelectedItem, ElementName=In}" FontFamily="{StaticResource SegoeUI}" Content="T" Click="Button_Click" ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.FillTitleIndex}" ContextMenuOpening="Button_ContextMenuOpening">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu ItemsSource="{Binding Elements}">
                                                                            <ContextMenu.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <TextBlock Text="{Binding Name}"/>
                                                                                </DataTemplate>
                                                                            </ContextMenu.ItemTemplate>
                                                                            <ContextMenu.ItemContainerStyle>
                                                                                <Style TargetType="MenuItem">
                                                                                    <Setter Property="Icon" Value="{Binding Index}"/>
                                                                                    <EventSetter Event="Click" Handler="MenuItem_Click"/>
                                                                                    <Setter Property="Tag" Value="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ContextMenu}}}"/>
                                                                                </Style>
                                                                            </ContextMenu.ItemContainerStyle>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <ComboBox Visibility="{Binding SelectedValue.IntValues, ElementName=Func, Converter={wpfc:ValueNullToInverseVisibilityConverter}}" IsEnabled="{Binding SelectedValue.HasIntProperty, ElementName=Func, FallbackValue=False}" ItemsSource="{Binding SelectedValue.IntValues, ElementName=Func}" Text="{Binding Parameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Grid>
                                                            <Label x:Name="StringValuesLabel" Margin="0,0,0,-8" Content="{Binding SelectedValue.StringDescription, ElementName=Func, FallbackValue=N/A}"/>
                                                            <Grid  x:Name="StringValuesGrid" Margin="0,0,0,-8">
                                                                <TextBox Height="Auto" Margin="0,3,0,2" TextWrapping="Wrap" Style="{StaticResource WidgetTextBox}" Visibility="{Binding SelectedValue.StringValues, ElementName=Func, Converter={wpfc:ValueNullToVisibilityConverter}}" IsEnabled="{Binding SelectedValue.HasStringProperty, ElementName=Func, FallbackValue=False}" Text="{Binding StringParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                                <ComboBox Visibility="{Binding SelectedValue.StringValues, ElementName=Func, Converter={wpfc:ValueNullToInverseVisibilityConverter}}" IsEnabled="{Binding SelectedValue.HasStringProperty, ElementName=Func, FallbackValue=False}" ItemsSource="{Binding SelectedValue.StringValues, ElementName=Func}" Text="{Binding StringParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Grid>

                                                            <Label x:Name="FloatValuesLabel" Content="{Binding SelectedValue.FloatDescription, ElementName=Func, FallbackValue=N/A}" Visibility="{Binding SelectedValue.HasFloatProperty, ElementName=Func, Converter={wpfc:BoolToVisibilityConverter}}"/>
                                                            <Border>
                                                                <TextBox IsEnabled="{Binding SelectedValue.HasFloatProperty, ElementName=Func, FallbackValue=False}" x:Name="FloatValuesGrid" Height="Auto" Margin="0,3,0,2" TextWrapping="Wrap" Style="{StaticResource WidgetTextBox}" Visibility="{Binding SelectedValue.HasFloatProperty, ElementName=Func, Converter={wpfc:BoolToVisibilityConverter}}" Text="{Binding FloatParameter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                            </Border>
                                                            
                                                            <Label Visibility="Collapsed" x:Name="In2Label">
                                                                <TextBlock>
<Run Text="{Binding SelectedValue.InputDescription, ElementName=Func, FallbackValue=N/A}"/>
<Run> 2</Run>
                                                                </TextBlock>
                                                            </Label>
                                                            <ComboBox ItemTemplate="{StaticResource InputSelectorTemplate}" Visibility="Collapsed" x:Name="In2" IsEnabled="{Binding SelectedValue.HasInputProperty, ElementName=Func, FallbackValue=False}" DisplayMemberPath="Title" SelectedValuePath="Key" SelectedValue="{Binding AdditionalParameters[0].A, Mode=TwoWay}" ItemsSource="{Binding AvailableInputs, ElementName=Me}"/>
                                                            <Label Visibility="Collapsed" x:Name="CondLabel" Content="{loc:Loc Key=ScriptEditor.Field.Condition}"/>
                                                            <Grid Visibility="Collapsed" x:Name="Cond">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition/>
                                                                    <ColumnDefinition Width="64"/>
                                                                    <ColumnDefinition/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox TextWrapping="Wrap" Margin="0,3,0,2" Height="Auto" Style="{StaticResource WidgetTextBox}" Text="{Binding AdditionalParameters[1].A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"></TextBox>
                                                                <ComboBox SelectedValue="{Binding AdditionalParameters[2].A, Mode=TwoWay}" Grid.Column="1">
                                                                    <c:String>&gt;</c:String>
                                                                    <c:String>&lt;</c:String>
                                                                    <c:String>&lt;=</c:String>
                                                                    <c:String>&gt;=</c:String>
                                                                    <c:String>==</c:String>
                                                                    <c:String>!=</c:String>
                                                                </ComboBox>
                                                                <TextBox TextWrapping="Wrap" Margin="0,3,0,2" Height="Auto" Style="{StaticResource WidgetTextBox}" Text="{Binding AdditionalParameters[3].A, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="2"></TextBox>
                                                            </Grid>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedValue.HasInputProperty, ElementName=Func, FallbackValue=False}" Value="False">
                                                                <Setter TargetName="InLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="In" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedValue.HasIntProperty, ElementName=Func, FallbackValue=False}" Value="False">
                                                                <Setter TargetName="IntValuesLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="IntValuesGrid" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedValue.HasStringProperty, ElementName=Func, FallbackValue=False}" Value="False">
                                                                <Setter TargetName="StringValuesLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="StringValuesGrid" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedValue.HasFloatProperty, ElementName=Func, FallbackValue=False}" Value="False">
                                                                <Setter TargetName="FloatValuesLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="FloatValuesGrid" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedValue.CommandType, ElementName=Func}" Value="Condition">
                                                                <Setter TargetName="In2Label" Property="Margin" Value="0,-8,0,0"/>
                                                                <Setter TargetName="In2Label" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="In2" Property="Margin" Value="0,-8,0,0"/>
                                                                <Setter TargetName="In2" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="CondLabel" Property="Visibility" Value="Visible"/>
                                                                <Setter TargetName="Cond" Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedValue.HideParameters, ElementName=Func}" Value="3">
                                                                <Setter TargetName="IntValuesLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="IntValuesGrid" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="FloatValuesLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="FloatValuesGrid" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="StringValuesLabel" Property="Visibility" Value="Collapsed"/>
                                                                <Setter TargetName="StringValuesGrid" Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding SelectedValue.HasInputProperty, ElementName=Func}" Value="True"/>
                                                                    <Condition Binding="{Binding NoInputAssigned}" Value="True"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <MultiDataTrigger.Setters>
                                                                    <Setter Property="Tag">
                                                                        <Setter.Value>
                                                                            <sys:Visibility>Visible</sys:Visibility>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </MultiDataTrigger.Setters>
                                                            </MultiDataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </Grid.Resources>
                                                <Grid Margin="{StaticResource StdMargin}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Label VerticalAlignment="Center">

                                                        <TextBlock VerticalAlignment="Center">
                                    <Run>#</Run>
                                    
                                    <Run Text="{Binding (ItemsControl.AlternationIndex),
           RelativeSource={RelativeSource AncestorType=ListViewItem}, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Label>
                                                    <Grid Grid.Column="1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center" Grid.Column="1" Orientation="Horizontal">
                                                            <CheckBox Cursor="Hand" IsChecked="{Binding Collapsed}">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox">
                                                                        <Setter Property="Template">
                                                                            <Setter.Value>
                                                                                <ControlTemplate TargetType="CheckBox">
                                                                                    <Border>
                                                                                        <TextBlock FontSize="16" x:Name="textBox" FontFamily="/vMixControllerSkin;Component/#Material Design Icons" Foreground="{StaticResource ComboBox.Static.Glyph}" Text="&#xF6F1;"/>
                                                                                    </Border>
                                                                                    <ControlTemplate.Triggers>
                                                                                        <Trigger Property="IsChecked" Value="True">
                                                                                            <Setter TargetName="textBox" Property="Text" Value="&#xF703;" />
                                                                                        </Trigger>
                                                                                    </ControlTemplate.Triggers>
                                                                                </ControlTemplate>
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                        </StackPanel>
                                                        <!--<Label Content="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListViewItem}}"></Label>-->

                                                        <ContentPresenter Grid.Column="2" Content="{Binding}" x:Name="Content">
                                                            <ContentPresenter.Tag>
                                                                <sys:Visibility>Collapsed</sys:Visibility>
                                                            </ContentPresenter.Tag>
                                                            <ContentPresenter.Style>
                                                                <Style TargetType="ContentPresenter">
                                                                    <Setter Property="ContentTemplate" Value="{StaticResource CollapsedViewTemplate}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Collapsed}" Value="False">
                                                                            <Setter Property="ContentTemplate" Value="{StaticResource ExpandedViewTemplate}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentPresenter.Style>
                                                        </ContentPresenter>

                                                    </Grid>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                                                        <TextBlock Margin="{StaticResource StdMargin}" ToolTip="{loc:Loc Key=ScriptEditor.Warning.NoInputAssigned}" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="NoInputAssigned" Foreground="Yellow" Visibility="{Binding Tag, ElementName=Content}" FontFamily="{StaticResource FontAwesome}">&#xF071;</TextBlock>

                                                        <CheckBox IsChecked="{Binding IsExecutable}" ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.ExecuteThisFunction}" Margin="{StaticResource StdMargin}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox">
                                                                    <Setter Property="FontSize" Value="14"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="CheckBox">
                                                                                <Border>
                                                                                    <TextBlock FontSize="{TemplateBinding FontSize}" x:Name="textBox" FontFamily="{StaticResource FontAwesome}" Foreground="Gray" Text="&#xF05D;"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="textBox" Property="Text" Value="&#xF058;" />
                                                                                        <Setter TargetName="textBox" Property="Foreground" Value="White"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>

                                                        <CheckBox IsChecked="{Binding UseInActiveState}" ToolTip="{loc:Loc Key=ScriptEditor.ToolTip.UseInStateDependency}" Margin="{StaticResource StdMargin}" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <CheckBox.Style>
                                                                <Style TargetType="CheckBox">
                                                                    <Setter Property="FontSize" Value="14"/>
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="CheckBox">
                                                                                <Border>
                                                                                    <TextBlock FontSize="{TemplateBinding FontSize}" x:Name="textBox" FontFamily="{StaticResource FontAwesome}" Foreground="Gray" Text="&#xF006;"/>
                                                                                </Border>
                                                                                <ControlTemplate.Triggers>
                                                                                    <Trigger Property="IsChecked" Value="True">
                                                                                        <Setter TargetName="textBox" Property="Text" Value="&#xF005;" />
                                                                                        <Setter TargetName="textBox" Property="Foreground" Value="White"/>
                                                                                    </Trigger>
                                                                                </ControlTemplate.Triggers>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </Style>
                                                            </CheckBox.Style>
                                                        </CheckBox>
                                                        <Button Content="&#xF0C9;">
                                                            <Button.Resources>
                                                                <cls:BindingProxy x:Key="Proxy" Data="{Binding ElementName=Me}"/>
                                                                <cls:BindingProxy x:Key="CommandProxy" Data="{Binding}"/>
                                                            </Button.Resources>
                                                            <Button.Style>
                                                                <Style BasedOn="{StaticResource TitleButton}" TargetType="{x:Type Button}">
                                                                    <Style.Triggers>
                                                                        <EventTrigger RoutedEvent="Click">
                                                                            <EventTrigger.Actions>
                                                                                <BeginStoryboard>
                                                                                    <Storyboard>
                                                                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetProperty="ContextMenu.IsOpen">
                                                                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                                                                        </BooleanAnimationUsingKeyFrames>
                                                                                    </Storyboard>
                                                                                </BeginStoryboard>
                                                                            </EventTrigger.Actions>
                                                                        </EventTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <Button.ContextMenu>
                                                                <ContextMenu DataContext="{Binding Source={StaticResource Proxy}}">
                                                                    <MenuItem Command="{Binding Data.MoveCommandUpCommand}" CommandParameter="{Binding Data, Source={StaticResource CommandProxy}}" Header="{loc:Loc Key=ScriptEditor.Menu.MoveUp}">
                                                                        <MenuItem.Icon>
                                                                            <Viewbox Width="16" Height="16">
                                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontAwesome}">&#xF30C;</TextBlock>
                                                                            </Viewbox>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <!--Header="&#xF30C;"-->
                                                                    <MenuItem Command="{Binding Data.MoveCommandDownCommand}" CommandParameter="{Binding Data, Source={StaticResource CommandProxy}}" Header="{loc:Loc Key=ScriptEditor.Menu.MoveDown}">
                                                                        <MenuItem.Icon>
                                                                            <Viewbox Width="16" Height="16">
                                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontAwesome}">&#xF309;</TextBlock>
                                                                            </Viewbox>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <!--Header="&#xF309;"-->
                                                                    <MenuItem Command="{Binding Data.DuplicateCommandCommand}" CommandParameter="{Binding Data, Source={StaticResource CommandProxy}}" Header="{loc:Loc Key=ScriptEditor.Menu.Duplicate}">
                                                                        <MenuItem.Icon>
                                                                            <Viewbox Width="16" Height="16">
                                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontAwesome}">&#xF24D;</TextBlock>
                                                                            </Viewbox>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <!--Header="&#xF24D;"-->
                                                                    <MenuItem Command="{Binding Data.RemoveCommandCommand}" CommandParameter="{Binding Data, Source={StaticResource CommandProxy}}" Header="{loc:Loc Key=ScriptEditor.Menu.Remove}">
                                                                        <MenuItem.Icon>
                                                                            <Viewbox Width="16" Height="16">
                                                                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource FontAwesome}">&#xF2ED;</TextBlock>
                                                                            </Viewbox>
                                                                        </MenuItem.Icon>
                                                                    </MenuItem>
                                                                    <!--Header="&#xF2ED;"-->
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                        <!--<Button Style="{StaticResource TitleButton}" HorizontalAlignment="Left" Command="{Binding MoveCommandUpCommand, ElementName=Me}" CommandParameter="{Binding}" ToolTip="Move Up" Content="&#xF30C;"/>
                                                        <Button Style="{StaticResource TitleButton}" HorizontalAlignment="Left" Command="{Binding MoveCommandDownCommand, ElementName=Me}" CommandParameter="{Binding}" ToolTip="Move Down" Content="&#xF309;"/>
                                                        <Button Style="{StaticResource TitleButton}" HorizontalAlignment="Left" Command="{Binding DuplicateCommandCommand, ElementName=Me}" CommandParameter="{Binding}"  ToolTip="Duplicate" Content="&#xF24D;"/>
                                                        <Button Style="{StaticResource TitleButton}" HorizontalAlignment="Left" Command="{Binding RemoveCommandCommand, ElementName=Me}" CommandParameter="{Binding}"  ToolTip="Remove" Content="&#xF2ED;"/>-->
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>


                                            <DataTrigger Binding="{Binding IsExecutable}" Value="True">
                                                <Setter TargetName="Border" Property="BorderBrush" Value="Green"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListViewItem">
                                                    <Border x:Name="border" Margin="{Binding Ident}" BorderBrush="Transparent" BorderThickness="2" HorizontalAlignment="Stretch">
                                                        <ContentPresenter/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>
                            </ListView>
                            <Button x:Name="appendButton" Width="Auto" Style="{StaticResource TitleButton}" FontFamily="{StaticResource SegoeUI}" Command="{Binding AddCommandCommand, ElementName=Me}" Content="{loc:Loc Key=ScriptEditor.Button.AppendCommand}"/>
                        </StackPanel>
                    </TabItem>
                    <TabItem Style="{StaticResource TabItemStyle}" Header="{loc:Loc Key=ScriptEditor.Tab.Code}">
                        <!--Text="{Binding TextCode, ElementName=Me, UpdateSourceTrigger=PropertyChanged}"-->
                        <StackPanel VerticalAlignment="Stretch">
                            <StackPanel Margin="4">
                                <TextBlock Text="{loc:Loc Key=ScriptEditor.Hint.CtrlSpace}"/>
                                <TextBlock Text="{loc:Loc Key=ScriptEditor.Hint.Tab}"/>
                            </StackPanel>
                            <cls:BindableAvalonEditor MinHeight="200px" x:Name="Code" Background="{StaticResource Button.Static.Background}" Foreground="White" ShowLineNumbers="True" LostFocus="BindableAvalonEditor_LostFocus" GotFocus="BindableAvalonEditor_GotFocus">

                            </cls:BindableAvalonEditor>
                        </StackPanel>
                    </TabItem>
                    <TabItem Style="{StaticResource TabItemStyle}" Header="{loc:Loc Key=ScriptEditor.Tab.Log}">
                        <TextBox Text="{Binding Log, ElementName=Me, FallbackValue={loc:Loc Key=ScriptEditor.Log.NoLogAvailable}}" TextWrapping="Wrap" IsReadOnly="True"></TextBox>
                    </TabItem>
                    <TabItem Style="{StaticResource TabItemStyle}" Header="{loc:Loc Key=ScriptEditor.Tab.Help}">
                        <ScrollViewer MaxHeight="256">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.Intro}"/>
                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Margin="0,8,0,0" Text="{loc:Loc Key=ScriptEditor.Help.Section.Constructor}"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.Constructor.1}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.Constructor.2}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.Constructor.3}"/>
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" FontWeight="Bold" Margin="0,8,0,0" Text="{loc:Loc Key=ScriptEditor.Help.Section.CodeEditor}"/>
                                <StackPanel Margin="8,0,0,0">
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.CodeEditor.1}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.CodeEditor.2}"/>
                                    <TextBlock TextWrapping="Wrap" Text="{loc:Loc Key=ScriptEditor.Help.CodeEditor.3}"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </StackPanel>
        </Border>
        <Control x:Name="bottomMarker"/>
    </StackPanel>
</UserControl>

