    </DataTemplate>
    <DataTemplate x:Key="vMixControlVariableViewerPropEditor" DataType="{x:Type widget:vMixControlVariableViewer}">
        <StackPanel>
            <prop:ComboBoxControl Title="{loc:Loc Key=PropertyEditor.Common.Variable}" Value="{Binding Variable, Mode=TwoWay, UpdateSourceTrigger=Explicit}" Items="{Binding VariableList}"/>
            <prop:BoolControl Title="{loc:Loc Key=PropertyEditor.Common.ShowVariableName}" Value="{Binding ShowVariableName, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="vMixControlMultiStatePropEditor" DataType="{x:Type widget:vMixControlMultiState}">
        <StackPanel>
            <prop:StringControl Title="{loc:Loc Key=PropertyEditor.Common.IP}" Value="{Binding IP, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="{loc:Loc Key=PropertyEditor.Common.Port}" Value="{Binding Port, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="{loc:Loc Key=PropertyEditor.Common.Login}" Value="{Binding Login, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
            <prop:StringControl Title="{loc:Loc Key=PropertyEditor.Common.Password}" Value="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=Explicit}"/>
        </StackPanel>
    </DataTemplate>
    <!--<DataTemplate x:Key="vMixControlLabelPropEditor" DataType="{x:Type widget:vMixControlLabel}"/>-->
</ResourceDictionary>
    