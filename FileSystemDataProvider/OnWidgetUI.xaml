<UserControl x:Class="FileSystemDataProviderNs.OnWidgetUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             
             xmlns:skin="clr-namespace:vMixControllerSkin;assembly=vMixControllerSkin"
             xmlns:loc="clr-namespace:vMixControllerSkin.Localization;assembly=vMixControllerSkin"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300"
             x:Name="_xmlUi">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vMixControllerSkin;component/MainSkin.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel>
        <Grid>
            <skin:PropertiesListView>
                <CompositeCollection>
                    <TextBox skin:TextBoxCommandBehavior.Enable="True" Style="{StaticResource WidgetTextBox}" Text="{Binding Path}">
                        <TextBox.Tag>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Loc Key=DataProvder.Filesystem.Path}"></TextBlock>
                        </TextBox.Tag>
                    </TextBox>
                    <TextBox skin:TextBoxCommandBehavior.Enable="True" Style="{StaticResource WidgetTextBox}" Text="{Binding Filter}">
                        <TextBox.Tag>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Loc Key=DataProvder.Filesystem.Filter}"/>
                        </TextBox.Tag>
                    </TextBox>
                    <CheckBox IsChecked="{Binding IncludeSubDirectories}">
                        <CheckBox.Tag>
                            <TextBlock Style="{StaticResource CaptionText}" Text="{loc:Loc Key=DataProvder.Filesystem.IncludeSubDirectories}"></TextBlock>
                        </CheckBox.Tag>
                    </CheckBox>
                </CompositeCollection>
            </skin:PropertiesListView>
        </Grid>
        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Error}"/>
        <Separator/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Margin="{StaticResource StdMargin}" Style="{StaticResource PropertyName}"><Run Text="{loc:Loc Key=DataProvider.Shared.Loaded}"/> <Run Text="{Binding Values.Length, Mode=OneWay}"></Run> <Run Text="{loc:Loc Key=DataProvider.Shared.Rows}"/></TextBlock>
            <Button Grid.Column="1" Command="{Binding ShowRowsCommand}" Content="{loc:Loc Key=DataProvider.Shared.ShowRows}"></Button>
        </Grid>
    </StackPanel>
</UserControl>
